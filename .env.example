# Copy to `.env` for local development. The deployed container gets these from its compose
# file or the host environment instead -- nothing here is baked into the image.

# SQLite database. The container overrides this with file:/db/yearbook.db (a mounted volume).
DATABASE_URL="file:./library/db/yearbook.db"

CF_ACCESS_AUD="abc123"
CF_ACCESS_TEAM_DOMAIN="https://myaccount.cloudflareaccess.com"

# Where photos, exports and generated files are written.
#   FILES_FOLDER       -- used when running inside a container (PWD is /app); mounted volume.
#   FILES_FOLDER_LOCAL -- used when running `pnpm dev` directly on your own machine.
FILES_FOLDER="/files"
FILES_FOLDER_LOCAL="./library/files"

# Cloudflare Access application to verify tokens against. Per-deployment: a second hostname
# is normally a second Access application with its own audience tag. Optional -- the defaults
# in $lib/server/auth are the existing dev application.
# CF_ACCESS_TEAM_DOMAIN="https://your-team.cloudflareaccess.com"
# CF_ACCESS_AUD="<application audience tag>"
